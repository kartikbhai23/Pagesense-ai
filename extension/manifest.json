
{
  "manifest_version": 3,
  "name": "Chat With This Page",
  "version": "1.0.0",
  "description": "Ask questions about the current webpage using Gemini.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
